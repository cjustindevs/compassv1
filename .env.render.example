# ============================================================================
# COMPASS -- Render.com environment variables (example)
#
# COPY THESE INTO the Render dashboard:  New Web Service > Environment tab.
# Never commit a real .env file. Values set in Render override these.
#
# Render-specific documentation: RENDER_DEPLOYMENT.md
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME="COMPASS"
APP_ENV=production
# REQUIRED -- generate with:  php artisan key:generate --show
# Enter the returned 32-char string exactly (base64:... form is also accepted).
APP_KEY=
APP_DEBUG=false
APP_URL=https://compass-demo.onrender.com   # your real Render URL, no trailing slash
APP_MAINTENANCE_DRIVER=file

# --- Database (managed PostgreSQL on Render) ---------------------------------
# Render's free tier includes ONE free managed PostgreSQL service, created by
# this Blueprint. Copy those values into the Dashboard (or let render.yaml
# auto-wire them via fromDatabase). Port 5432, driver pgsql.
DB_CONNECTION=pgsql
DB_HOST=compass-postgres            # seen in the "PostgreSQL" service settings
DB_PORT=5432
DB_DATABASE=compass
DB_USERNAME=compass
DB_PASSWORD=
DB_SSLMODE=prefer                   # Render Postgres supports TLS on both internal and external URLs
# Optional: absolute path to a CA bundle for encrypted connections. Leave empty
# when the provider uses a publicly-trusted cert (most do).
MYSQL_ATTR_SSL_CA=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Identity vault (same managed PostgreSQL database) ------------------------
# The COMPASS emergency identity vault keeps identity records separate FROM THE
# APPLICATIONS' LOGIC, but Render's free tier allows only ONE database, so the
# vault reuses the same database/credentials and its dedicated migrations create
# the `idv_*` tables beside the main tables (managed by start.sh and by
# `php artisan migrate --database=identity_vault --path=database/migrations/identity_vault`).
# On a self-hosted Postgres you CAN point these at a truly separate database.
DB_IDENTITY_CONNECTION=pgsql
DB_IDENTITY_HOST=compass-postgres
DB_IDENTITY_PORT=5432
DB_IDENTITY_DATABASE=compass
DB_IDENTITY_USERNAME=compass
DB_IDENTITY_PASSWORD=
# REQUIRED -- generate with:
#   php artisan tinker --execute="echo \Illuminate\Support\Str::random(32);"
IDENTITY_VAULT_ENCRYPTION_KEY=
# Optional comma-separated user ids of designated emergency professional responders.
IDENTITY_VAULT_RESPONDER_IDS=

# --- Sessions ---------------------------------------------------------------
# Database-backed sessions survive Render's ephemeral disk.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=compass-session

# --- Cache ------------------------------------------------------------------
# File cache for the single Render web instance. The database cache store
# previously stalled every rate-limited AJAX call (OTP, alias shuffle) via the
# cache/cache_locks tables, returning HTTP 500. Sessions stay in the database.
CACHE_STORE=file

# --- Queue ------------------------------------------------------------------
# COMPASS has no queued jobs (notifications, referral and emergency flows run
# inline), so the sync driver runs every workflow in-request and needs no
# background worker. Keep this on "sync" for the free tier.
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

# --- Broadcasting / Reverb ---------------------------------------------------
# Default for the free demo: "log" keeps the app fully functional through the
# built-in polling fallbacks (chat, notifications, referral consent) without a
# WebSocket server. Realtime (Echo) will NOT push instantly in this mode.
BROADCAST_CONNECTION=log
#
# OPTIONAL -- to enable real-time WebSockets you must run Reverb and set these.
# Reverb is not started by the default container (it needs process supervision
# and an extra port or a `wss` proxy). See RENDER_DEPLOYMENT.md, "Realtime".
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=123456
# REVERB_APP_KEY=compass-chat-key
# REVERB_APP_SECRET=compass-chat-secret
# REVERB_HOST=compass-ws.onrender.com
# REVERB_PORT=6001
# REVERB_SCHEME=wss
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=6001
# REVERB_APP_MAX_CONNECTIONS=100

# Frontend Echo keeps in sync with the backend env (rebuilt by Docker).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY:-compass-chat-key}"
VITE_REVERB_HOST="${REVERB_HOST:-}"
VITE_REVERB_PORT="${REVERB_PORT:-8080}"
VITE_REVERB_SCHEME="${REVERB_SCHEME:-https}"

# --- Storage ----------------------------------------------------------------
# Profile avatars currently use public/uploads on the container filesystem.
# Render free instances have NO persistent disk -- uploads are lost on deploy
# or sleep wake. For durable uploads point FILESYSTEM_DISK at an S3-compatible
# bucket (Render free does not include one; S3 is outside free tier).
FILESYSTEM_DISK=local

# --- Mail -------------------------------------------------------------------
# Real SMTP so OTP codes are emailed and never shown on screen. For Gmail use
# an App Password (needs 2-Step Verification on the account):
#   https://myaccount.google.com/apppasswords
# With the mailer at "smtp" OTP codes are NEVER displayed in the UI; a wrong
# or missing MAIL_PASSWORD makes send return HTTP 503 (readable message shown).
# Gmail occasionally blocks Render datacenter IPs -- Resend is the fallback.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="projectdialafriendorganization@gmail.com"
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="projectdialafriendorganization@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Demo data ----------------------------------------------------------------
# A freshly provisioned database has no accounts. Set to true to seed the
# documented demo logins on first boot (guarded -- runs only while the demo
# accounts are missing, so it never duplicates or wipes data):
#   admin@example.com            / password
#   seeker@compass.edu.ph        / password123
#   helper@compass.edu.ph        / password123
#   adviser@compass.edu.ph       / password123
#   professional@compass.edu.ph  / password123
# Plus named @compass.local accounts (2+ per role, password <Role>@123):
#   rina@compass.local           / Seeker@123
#   andre@compass.local          / Seeker@123
#   jasmine@compass.local        / Seeker@123
#   leo@compass.local            / Seeker@123
#   elsa@compass.local           / Helper@123
#   gab@compass.local            / Helper@123
#   camille@compass.local        / Adviser@123
#   miguel@compass.local         / Adviser@123
#   angelica@compass.local       / Professional@123
#   victor@compass.local         / Professional@123
#   sophia@compass.local         / Moderator@123
#   rafael@compass.local         / Moderator@123
RUN_SEED_DEMO=true

# --- Duty hours (testing mode) ------------------------------------------------
# Defaults to true. While enabled, helper matching bypasses duty-hour
# gatekeeping so every feature can be tested end to end: institutional
# verification & training approval, official duty shift, readiness check,
# the two-session shift limit, the helper's availability toggle, and the
# 6:00-10:30 PM operating-hours window are all SKIPPED.
#
# Hard safety rules always remain enforced: active account, active primary
# adviser, not under review, no declared conflict, no concurrent active
# assignment, and competency/risk gates.
#
# Set to false when the institution wants real enforcement back.
RELAX_DUTY_HOURS=false

# --- Operating hours (testing mode) --------------------------------------------
# The 6:00-10:30 PM (Mon-Sat) assignment window is currently NOT enforced so
# features can be tested at any hour. Set to true to turn the window back on.
ENFORCE_DUTY_HOURS=false

# --- Logging ----------------------------------------------------------------
# stderr is captured by Render's log dashboard.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=error

# --- Scheduler ----------------------------------------------------------------
# Runs the Laravel scheduler inside the web container so automatic helper
# matching, queue aging, session expiry and workflow maintenance keep working
# on the free tier. Set to false to disable (matching will stop).
RUN_SCHEDULER=true

# --- Screening approval gates (set only when the institution approved them) --
SCREENING_APPROVAL_REFERENCE=
SCREENING_APPROVED_VERSION=