# ============================================================================
# COMPASS -- Render.com environment variables (example)
#
# COPY THESE INTO the Render dashboard:  New Web Service > Environment tab.
# Never commit a real .env file. Values set in Render override these.
#
# Render-specific documentation: RENDER_DEPLOYMENT.md
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME="COMPASS"
APP_ENV=production
# REQUIRED -- generate with:  php artisan key:generate --show
# Enter the returned 32-char string exactly (base64:... form is also accepted).
APP_KEY=
APP_DEBUG=false
APP_URL=https://compass-demo.onrender.com   # your real Render URL, no trailing slash
APP_MAINTENANCE_DRIVER=file

# --- Database (managed PostgreSQL on Render) ---------------------------------
# Render's free tier includes ONE free managed PostgreSQL service, created by
# this Blueprint. Copy those values into the Dashboard (or let render.yaml
# auto-wire them via fromDatabase). Port 5432, driver pgsql.
DB_CONNECTION=pgsql
DB_HOST=compass-postgres            # seen in the "PostgreSQL" service settings
DB_PORT=5432
DB_DATABASE=compass
DB_USERNAME=compass
DB_PASSWORD=
# Optional: absolute path to a CA bundle for encrypted connections. Leave empty
# when the provider uses a publicly-trusted cert (most do).
MYSQL_ATTR_SSL_CA=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Isolated identity vault (second database on the same PostgreSQL server) -
# The COMPASS emergency identity vault keeps identity records in a separate
# database. Use the SAME Render-managed Postgres instance but its own database
# name, user and password (Render free includes ONE Postgres instance; the
# container auto-creates this database best-effort on boot -- see start.sh).
DB_IDENTITY_CONNECTION=pgsql
DB_IDENTITY_HOST=compass-postgres
DB_IDENTITY_PORT=5432
DB_IDENTITY_DATABASE=compass_identity_vault
DB_IDENTITY_USERNAME=compass_identity_vault
DB_IDENTITY_PASSWORD=
# REQUIRED -- generate with:
#   php artisan tinker --execute="echo \Illuminate\Support\Str::random(32);"
IDENTITY_VAULT_ENCRYPTION_KEY=
# Optional comma-separated user ids of designated emergency professional responders.
IDENTITY_VAULT_RESPONDER_IDS=
# Optional comma-separated user ids of designated emergency professional responders.
IDENTITY_VAULT_RESPONDER_IDS=

# --- Sessions ---------------------------------------------------------------
# Database-backed sessions survive Render's ephemeral disk.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=compass-session

# --- Cache ------------------------------------------------------------------
CACHE_STORE=database

# --- Queue ------------------------------------------------------------------
# COMPASS has no queued jobs (notifications, referral and emergency flows run
# inline), so the sync driver runs every workflow in-request and needs no
# background worker. Keep this on "sync" for the free tier.
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

# --- Broadcasting / Reverb ---------------------------------------------------
# Default for the free demo: "log" keeps the app fully functional through the
# built-in polling fallbacks (chat, notifications, referral consent) without a
# WebSocket server. Realtime (Echo) will NOT push instantly in this mode.
BROADCAST_CONNECTION=log
#
# OPTIONAL -- to enable real-time WebSockets you must run Reverb and set these.
# Reverb is not started by the default container (it needs process supervision
# and an extra port or a `wss` proxy). See RENDER_DEPLOYMENT.md, "Realtime".
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=123456
# REVERB_APP_KEY=compass-chat-key
# REVERB_APP_SECRET=compass-chat-secret
# REVERB_HOST=compass-ws.onrender.com
# REVERB_PORT=6001
# REVERB_SCHEME=wss
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=6001
# REVERB_APP_MAX_CONNECTIONS=100

# Frontend Echo keeps in sync with the backend env (rebuilt by Docker).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY:-compass-chat-key}"
VITE_REVERB_HOST="${REVERB_HOST:-}"
VITE_REVERB_PORT="${REVERB_PORT:-8080}"
VITE_REVERB_SCHEME="${REVERB_SCHEME:-https}"

# --- Storage ----------------------------------------------------------------
# Profile avatars currently use public/uploads on the container filesystem.
# Render free instances have NO persistent disk -- uploads are lost on deploy
# or sleep wake. For durable uploads point FILESYSTEM_DISK at an S3-compatible
# bucket (Render free does not include one; S3 is outside free tier).
FILESYSTEM_DISK=local

# --- Mail -------------------------------------------------------------------
# Log-only for the demo. Emails (if any) are written to the container log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="compass@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Logging ----------------------------------------------------------------
# stderr is captured by Render's log dashboard.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=error

# --- Scheduler ----------------------------------------------------------------
# Runs the Laravel scheduler inside the web container so automatic helper
# matching, queue aging, session expiry and workflow maintenance keep working
# on the free tier. Set to false to disable (matching will stop).
RUN_SCHEDULER=true

# --- Screening approval gates (set only when the institution approved them) --
SCREENING_APPROVAL_REFERENCE=
SCREENING_APPROVED_VERSION=